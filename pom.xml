	<groupId>Baaz</groupId>
	<artifactId>Baaz-Mobile</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>Baaz-Mobile</name>
	<url>http://maven.apache.org</url>
	<properties>
		<jbehave.core.version>4.1.2</jbehave.core.version>
		<jbehave.web.version>4.0-beta-1</jbehave.web.version>
		<jbehave.site.version>3.3.1</jbehave.site.version>
		<junit-dep.version>4.11</junit-dep.version>
		<com.google.code.gson.version>2.8.5</com.google.code.gson.version>
		<maven-compiler-plugin.version>3.7.0</maven-compiler-plugin.version>
		<maven-dependency-plugin.version>3.0.2</maven-dependency-plugin.version>
		<de.codecentric.jbehave-junit-runner.version>1.2.0</de.codecentric.jbehave-junit-runner.version>
		<threads>1</threads>
		<story.timeout>2500</story.timeout>

		<!-- Want to run a subset of the tests? Pass -stories in with a new pattern. -->
		<stories>**/Stories.java</stories>
		<!-- Let's you change the meta-filter used in the plugin. Don't know what 
			that is, but it sounds cool -->
		<meta.filter></meta.filter>
		<!-- Probably wouldn't usually have these, but this is an example - and 
			it includes examples of failures. By ignoring failures, we can keep them 
			in and still have a passing build. -->
		<ignore.failure.in.stories>true</ignore.failure.in.stories>
		<ignore.failure.in.view>true</ignore.failure.in.view>


		<debug.mode>true</debug.mode>

		<!-- place holder for parameter passed from Jenkins -->
		<build.number>SNAPSHOT</build.number>

		<!-- place holder for parameter passed from Jenkins -->
		<build.id>SNAPSHOT</build.id>

		<!-- place holder for parameter passed from Jenkins -->
		<report.show.after.run>true</report.show.after.run>

	</properties>


